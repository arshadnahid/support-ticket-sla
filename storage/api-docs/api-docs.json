{
    "openapi": "3.0.0",
    "info": {
        "title": "Support Ticket SLA API",
        "description": "REST API for the Support Ticket SLA system. Authenticated endpoints expect a JWT in the `Authorization: Bearer <token>` header.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://support-ticket-sla.test",
            "description": "API server"
        }
    ],
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register a customer account",
                "description": "Self-registration always creates a **customer**. Admin and agent accounts are created by administrators.",
                "operationId": "authRegister",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Jane Customer",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jane@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Account created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/Token"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "example": "Registration successful"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log in and obtain a JWT",
                "description": "Get a JWT via given credentials.",
                "operationId": "authLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "nahid@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345678"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/Token"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "example": "Login successful"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid email or password",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        }
                                    ]
                                },
                                "example": {
                                    "data": null,
                                    "message": "Invalid email or password.",
                                    "errors": [],
                                    "success": false,
                                    "status": "error"
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AccountInactive"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Get the authenticated user",
                "description": "Get the authenticated User.",
                "operationId": "authMe",
                "responses": {
                    "200": {
                        "description": "Authenticated user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "properties": {
                                                        "user": {
                                                            "$ref": "#/components/schemas/User"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "403": {
                        "$ref": "#/components/responses/AccountInactive"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log out (invalidate the current token)",
                "description": "Log the user out (Invalidate the token).",
                "operationId": "authLogout",
                "responses": {
                    "200": {
                        "description": "Successfully logged out",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        }
                                    ]
                                },
                                "example": {
                                    "data": null,
                                    "message": "Successfully logged out",
                                    "errors": [],
                                    "success": true,
                                    "status": "success"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "403": {
                        "$ref": "#/components/responses/AccountInactive"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Refresh the current token",
                "description": "Accepts a valid token, or an expired one still inside the refresh window (JWT_REFRESH_TTL). The old token is blacklisted.",
                "operationId": "authRefresh",
                "responses": {
                    "200": {
                        "description": "Token refreshed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiResponse"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/Token"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "example": "Token refreshed"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "403": {
                        "$ref": "#/components/responses/AccountInactive"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "properties": {
                    "id": {
                        "description": "Global OpenAPI definitions (info, servers, security, shared schemas).\nRun `php artisan l5-swagger:generate` after changing any attribute.",
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Nahid"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "nahid@gmail.com"
                    },
                    "role": {
                        "type": "string",
                        "example": "customer",
                        "enum": [
                            "admin",
                            "agent",
                            "customer"
                        ]
                    },
                    "role_label": {
                        "type": "string",
                        "example": "Customer"
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "is_available": {
                        "description": "Only present for agents",
                        "type": "boolean",
                        "example": true
                    },
                    "email_verified_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "last_login_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Token": {
                "properties": {
                    "access_token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                    },
                    "token_type": {
                        "type": "string",
                        "example": "bearer"
                    },
                    "expires_in": {
                        "description": "Token lifetime in seconds",
                        "type": "integer",
                        "example": 3600
                    },
                    "user": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "type": "object"
            },
            "ApiResponse": {
                "description": "Standard response envelope used by every endpoint.",
                "properties": {
                    "data": {
                        "nullable": true
                    },
                    "message": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object"
                    },
                    "success": {
                        "type": "boolean"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "success",
                            "error"
                        ]
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "Unauthenticated": {
                "description": "Missing, invalid or expired token",
                "content": {
                    "application/json": {
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/ApiResponse"
                                }
                            ]
                        },
                        "example": {
                            "data": null,
                            "message": "Unauthenticated.",
                            "errors": [],
                            "success": false,
                            "status": "error"
                        }
                    }
                }
            },
            "ValidationError": {
                "description": "Validation failed",
                "content": {
                    "application/json": {
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/ApiResponse"
                                }
                            ]
                        },
                        "example": {
                            "data": null,
                            "message": "The given data was invalid.",
                            "errors": {
                                "email": [
                                    "The email field is required."
                                ]
                            },
                            "success": false,
                            "status": "error"
                        }
                    }
                }
            },
            "AccountInactive": {
                "description": "Account has been deactivated",
                "content": {
                    "application/json": {
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/ApiResponse"
                                }
                            ]
                        },
                        "example": {
                            "data": null,
                            "message": "Your account has been deactivated. Please contact an administrator.",
                            "errors": [],
                            "success": false,
                            "status": "error"
                        }
                    }
                }
            },
            "TooManyRequests": {
                "description": "Rate limit exceeded (5/min per email+IP, 20/min per IP)",
                "content": {
                    "application/json": {
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/ApiResponse"
                                }
                            ]
                        },
                        "example": {
                            "data": null,
                            "message": "Too many requests. Please try again later.",
                            "errors": [],
                            "success": false,
                            "status": "error"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "JWT access token returned by `POST /auth/login`.",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Authentication & token management"
        }
    ]
}